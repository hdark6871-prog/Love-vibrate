<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ہمارا پیار - لانگ ڈسٹنس کنکشن ❤️</title>
    
    <!-- Firebase SDK (Google CDN) -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>

    <style>
        body {
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            color: #fff;
            text-align: center;
        }

        .container {
            background: rgba(255, 255, 255, 0.2);
            padding: 30px;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
            max-width: 320px;
            width: 90%;
        }

        h2 {
            margin-bottom: 10px;
            color: #d63384;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }

        p {
            color: #555;
            font-size: 15px;
            margin-bottom: 25px;
        }

        .heart-btn {
            background: #ff3366;
            border: none;
            color: white;
            width: 110px;
            height: 110px;
            border-radius: 50%;
            font-size: 45px;
            cursor: pointer;
            box-shadow: 0px 6px 20px rgba(255, 51, 102, 0.5);
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
        }

        .heart-btn:active {
            transform: scale(0.9);
        }

        #status {
            margin-top: 20px;
            font-size: 14px;
            color: #444;
            font-weight: bold;
        }

        /* فلوٹنگ دلوں کا انیمیشن */
        .floating-heart {
            position: absolute;
            color: #ff3366;
            font-size: 24px;
            animation: floatUp 2s linear forwards;
            pointer-events: none;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
            100% {
                transform: translateY(-300px) scale(1.5);
                opacity: 0;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>فاصلے بے معنی ہیں!</h2>
        <p>جب دل چاہے اس دل پر ٹیپ کریں، ادھر دوسرے فون پر وائبریشن ہوگی ❤️</p>
        
        <button class="heart-btn" onclick="sendVibration()">❤️</button>
        
        <div id="status">کنیکٹ ہو رہا ہے...</div>
    </div>

    <script>
        // --- 1. فائر بیس کانفیگریشن (پبلک ٹیسٹ ڈیٹا بیس) ---
        const firebaseConfig = {
            databaseURL: "https://long-distance-love-default-rtdb.firebaseio.com/"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();
        const ref = db.ref("vibrationSignal");

        const statusDiv = document.getElementById("status");

        // --- 2. سگنل بھیجنے کا فنکشن (جب آپ یا وہ بٹن دبائیں) ---
        function sendVibration() {
            // فائر بیس پر نیا ٹائم اسٹैम्प بھیجیں تاکہ دوسرا فون فوراً پکڑ لے
            ref.set({
                time: Date.now(),
                sender: navigator.userAgent // شناخت کے لیے
            });

            // اپنے فون پر بھی خوشی کے لیے دل اڑائیں اور ہلکا وائبریट کریں
            createHeartEffect();
            if ("vibrate" in navigator) {
                navigator.vibrate([150, 100, 150]);
            }
        }

        // --- 3. سگنل سننے کا فنکشن (رئیل ٹائم لسنر) ---
        let isInitialLoad = true;
        ref.on("value", (snapshot) => {
            if (isInitialLoad) {
                isInitialLoad = false;
                statusDiv.innerText = "کنیکٹ ہو گیا ہے! ✅";
                return;
            }

            const data = snapshot.val();
            if (data) {
                // جیسے ہی ڈیٹا بدلے (کوئی دوسرا بٹن دبائے)، فون وائبریट کرے اور دل اڑیں!
                statusDiv.innerText = "پیار کا سگنل موصول ہوا! 💖";
                
                createHeartEffect();
                
                if ("vibrate" in navigator) {
                    navigator.vibrate([200, 100, 200, 100, 300]); // شاندار وائبریشن پیٹرن
                }

                setTimeout(() => {
                    statusDiv.innerText = "کنیکٹ ہو گیا ہے! ✅";
                }, 3000);
            }
        });

        // --- 4. سکرین پر پیارے دل اڑانے کا اینیمیشن ---
        function createHeartEffect() {
            for (let i = 0; i < 5; i++) {
                const heart = document.createElement("div");
                heart.className = "floating-heart";
                heart.innerHTML = "❤️";
                
                // رینڈم پوزیشن
                heart.style.left = Math.random() * 80 + 10 + "%";
                heart.style.bottom = "30%";
                
                document.body.appendChild(heart);

                // 2 سیکنڈ بعد ایلیمنٹ ڈیلیট کر دیں
                setTimeout(() => {
                    heart.remove();
                }, 2000);
            }
        }
    </script>

</body>
</html>
